+def tree_pids(pid):
+    """pids of a process and all its descendants"""
+    stack = [pid]; seen = set()
+    while stack:
+        q = stack.pop()
+        if q in seen: continue
+        seen.add(q)
+        try:
+            for t in os.listdir(f'/proc/{q}/task'):
+                stack += [int(x) for x in open(f'/proc/{q}/task/{t}/children').read().split()]
+        except Exception:
+            pass
+    return seen
+
+
+PAGE = os.sysconf('SC_PAGE_SIZE') if hasattr(os, 'sysconf') else 4096
+
+
+def proc_rss_max(exclude):
+    """largest resident set of a single process on this host outside `exclude` (audit-sds2-v5x): worker generations older than
+    the registry / rss-file runtime publish neither, so their converters (up to ~50 GB each on data-3) are only visible here"""
+    m = 0
+    for d in os.listdir('/proc'):
+        if not d.isdigit() or int(d) in exclude:
+            continue
+        try:
+            with open(f'/proc/{d}/statm') as fh:
+                m = max(m, int(fh.read().split()[1]) * PAGE)
+        except Exception:
+            pass
+    return m
 
 
