+            if (end == 'start' and k == 0) or (end == 'end' and k == len(D) - 1): continue
+            d0, d1 = D[j - 1], D[j]
+            th = math.acos(float(np.clip(d0 @ d1, -1, 1)))
+            if th > math.radians(150): capped += 1
+            e = min(R * math.tan(min(th, math.radians(150)) / 2), 5 * R) + 1.0
