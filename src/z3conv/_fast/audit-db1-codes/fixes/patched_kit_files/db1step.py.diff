+    y = np.asarray(m['y'], float); y = y - (y @ D[0]) * D[0]; y = y / np.linalg.norm(y); ys = [y]
+    for k in range(1, len(D)):
+        a = np.cross(D[k - 1], D[k]); s = float(np.linalg.norm(a)); c = float(D[k - 1] @ D[k]); yk = ys[-1]
