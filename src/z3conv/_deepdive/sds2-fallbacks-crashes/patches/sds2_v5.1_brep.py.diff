+def split_keyhole(loop):
+    """One stored loop that revisits a vertex -> [outer, inner, ...] (the bridge edge walked out and back is dropped)."""
+    out, cur = [], []
+    for i in loop:
+        if cur and i == cur[-1]:
+            continue
+        if i in cur:
+            j = cur.index(i); seg = cur[j:]; cur = cur[:j + 1]
+            if len(seg) >= 3:
+                out.append(seg)
+        else:
+            cur.append(i)
+    if len(cur) >= 3 and cur[0] == cur[-1]:
+        cur = cur[:-1]
+    return ([cur] if len(cur) >= 3 else []) + out
+
+
+def unkeyhole(f):
+    """Face entries with keyhole loops re-encoded as separate loops, each closed by repeating its first vertex
+    (the multi-loop encoding loops_of() reads); faces without a revisited vertex are returned unchanged."""
+    ls = loops_of(f)
+    if all(len(set(l)) == len(l) for l in ls):
+        return f
+    loops = [x for l in ls for x in (split_keyhole(l) if len(set(l)) != len(l) else [l])]
+    loops.sort(key=len, reverse=True)
+    nf = []
+    for l in loops:
+        nf += l + [l[0]]
+    return nf
 
 
