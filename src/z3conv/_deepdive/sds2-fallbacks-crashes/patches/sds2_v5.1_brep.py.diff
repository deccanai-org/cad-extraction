+        while ex.More():
+            sols.append(TopoDS.Solid(ex.Current())); ex.Next()
+        if len(sols) != 1 or not BRepCheck_Analyzer(sols[0]).IsValid():
+            return None
+        g = GProp_GProps(); BRepGProp.VolumeProperties_s(sols[0], g)
+        return sols[0] if g.Mass() > 0 else None
+    except Exception:
+        return None
