+def bolts_in_best_frame(job, n, frame, candidates, hole_faces, stats, tol=0.25):
+    """SDS2 bolt records of member n placed in the frame that puts their heads on decoded hole faces.
+    v4 placed every record in the member's 0xE8 main-material frame (header block when absent). That frame is wrong
+    when the header names a connection plate (7.331 VOID: BEAM W30x132 whose header piece is a PL5/8 -> its 28 bolts
+    written 3-9 in off and perpendicular to their holes, plus 28 nominal bolts in the empty holes) and on 7.1xx files
+    (7.135 BAHAMAR: 2 of 413 records on a hole; the member's own work-line frame puts 336 there). The v4 frame is kept
+    whenever every record lands on a hole face, when no holes were decoded, or when no other frame does better."""
+    import bolts as BR
+    from instances import _is_frame
+    if hole_faces is None:
+        return BR.member_bolts(job, n, frame)
+    raw = BR.member_bolts(job, n, (np.eye(3), np.zeros(3)))          # records in the record frame
+    if not raw:
+        return []
+    H = np.array([r["head"] for r in raw]); X = np.array([r["axis"] for r in raw])
+
+    def hits(M, o):
+        W = o + H @ M                                                # = o + M.T @ head, row-wise
+        ok = np.isfinite(W).all(1) & (np.abs(W).max(1) < 1e7)
+        if not ok.any():
+            return 0
+        d, _ = hole_faces.query(W[ok], distance_upper_bound=tol)
+        return int(np.isfinite(d).sum())
+
+    def placed(M, o):
+        return [dict(r, head=o + M.T @ r["head"], axis=M.T @ r["axis"]) for r in raw]
+
+    cands = []
+    if frame is not None:
+        cands.append((np.asarray(frame[0], float), np.asarray(frame[1], float)))
+    try:
+        import struct
+        b = open(os.path.join(job, "mem", str(n)), "rb").read(0xE8)
+        if len(b) >= 0xE8:
+            cands.append((np.array(struct.unpack(">9d", b[0x88:0xD0])).reshape(3, 3), np.array(struct.unpack(">3d", b[0xD0:0xE8]))))
+    except OSError:
+        pass
+    base = hits(*cands[0]) if cands else 0
+    if base == len(raw):
+        return placed(*cands[0])
+    best, bh = (cands[0] if cands else None), base
+    seen = set()
+    for M, o in list(cands[1:]) + [(np.asarray(M_, float), np.asarray(o_, float)) for M_, o_ in candidates]:
+        k = (tuple(np.round(M, 4).ravel()), tuple(np.round(o, 3)))
+        if k in seen or not _is_frame(M):
+            continue
+        seen.add(k)
+        h = hits(M, o)
+        if h > bh:
+            best, bh = (M, o), h
+    if best is None:
+        return BR.member_bolts(job, n, frame)
+    if bh > base and bh >= 0.5 * len(raw):
+        stats["bolt_record_frames_reselected"] = stats.get("bolt_record_frames_reselected", 0) + 1
+        return placed(*best)
+    return BR.member_bolts(job, n, frame)
 
 
+def stacks_covered(stacks, recs, lat_tol=1 / 16):
+    """Indices of hole stacks that an SDS2 bolt record already fills: record axis parallel to the stack, head within
+    1/16 in of the stack axis, and the record's plies [head, head + grip] overlapping the stack span by > 25 % of the
+    shorter. v4 required the head within 0.002 in of a stack end, so a record whose head sits on a washer / shim face
+    or a ply the stack does not include (8.004 Fire Station 41: 0.03-0.6 in) left its stack 'uncovered' and a second,
+    nominal bolt was written into the same holes (69 duplicates on that job)."""
+    from scipy.spatial import cKDTree
+    mids = np.array([e + a * g / 2 for e, a, g, d in stacks])
+    tree = cKDTree(mids); out = set()
+    for r in recs:
+        h, ax, gr = np.asarray(r["head"], float), np.asarray(r["axis"], float), float(r["grip"])
+        if not (np.isfinite(h).all() and np.isfinite(ax).all() and np.abs(h).max() < 1e7):
+            continue
+        for si in tree.query_ball_point(h + ax * gr / 2, 6.0):
+            e, a, g, d = stacks[si]
+            c = ax @ a
+            if abs(abs(c) - 1) > 1e-3:
+                continue
+            v = h - e; t0 = v @ a
+            if np.linalg.norm(v - t0 * a) > lat_tol:
+                continue
+            t1 = t0 + np.sign(c) * gr
+            if min(max(t0, t1), g) - max(min(t0, t1), 0.0) > 0.25 * min(g, gr):
+                out.add(si)
+    return out
+
