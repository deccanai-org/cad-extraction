+def _polygon_ring(V, x, rs, x0, x1, rr, a):
+    """v5.5w: when the ring at both ends of a segment has exactly 4 or 6 distinct vertices at the same angles (square /
+    hex bolt heads and nuts as SDS2 stores them), -> those cross-axis points in angle order, so the segment is the prism
+    of SDS2's own polygon; None -> a cylinder (faceted circles carry 12+ vertices). v5.4 wrote heads as cylinders
+    through the hexagon's corners: +21 % on the head (ASC 1/2 x 3 1/2 BLT 1.085x, Sinclair 5/8 x 9 BLT 1.068x SDS2)."""
+    o = [k for k in range(3) if k != a]
+    P0 = np.unique(np.round(V[(x == x0) & (rs == rr)][:, o], 4), axis=0)
+    P1 = np.unique(np.round(V[(x == x1) & (rs == rr)][:, o], 4), axis=0)
+    if len(P0) not in (4, 6) or len(P1) != len(P0):
+        return None
+    t0 = np.arctan2(P0[:, 1], P0[:, 0]); t1 = np.sort(np.arctan2(P1[:, 1], P1[:, 0]))
+    if np.abs(np.angle(np.exp(1j * (np.sort(t0) - t1)))).max() > 1e-2:
+        return None                                 # not the same polygon at both ends
+    return [(float(P0[k, 0]), float(P0[k, 1])) for k in np.argsort(t0)]
+
