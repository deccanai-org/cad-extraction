+def _snap(v, tol=2e-3):
+    """v5.5w: values closer than tol (gaps of the sorted values) -> their cluster mean. v5.4 rounded stations and radii
+    to 3 decimals, which splits a value on a .xxx5 boundary (radius 0.4375 -> 0.437 / 0.438, 0.3125 -> 0.312 / 0.313,
+    station 3.6875 -> 3.687 / 3.688): rings fell under 3 points or two stations lost their common radius, and studs /
+    bolts were written as their head only (EDWARDS AFB WS7/8: 0.07 vs SDS2 1.04 lb; Sinclair 5/8 x 9 BLT: 0.22 vs 0.86)."""
+    v = np.asarray(v, float)
+    if not len(v):
+        return v
+    o = np.argsort(v, kind="stable"); s_ = v[o]
+    gid = np.concatenate([[0], np.cumsum(np.diff(s_) > tol)])
+    mean = np.bincount(gid, weights=s_) / np.bincount(gid)
+    out = np.empty_like(v); out[o] = np.round(mean[gid], 4)
+    return out
+
