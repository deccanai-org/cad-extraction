+def _name_dia(name):
+    m = _DIA_RX.match(name or "")
+    if not m:
+        return None
+    try:
+        return sum(float(a) / float(b) if "/" in t else float(t) for t in m.group(1).split()
+                   for a, b in [t.split("/") if "/" in t else (t, 1)])
+    except (ValueError, ZeroDivisionError):
+        return None
