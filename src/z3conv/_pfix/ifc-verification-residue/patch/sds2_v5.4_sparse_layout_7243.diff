--- a/sds2-step-pipeline/decode/sds2job.py	2026-10-01 14:33:10
+++ b/sds2-step-pipeline/decode/sds2job.py	2026-10-01 20:39:44
@@ -323,6 +323,15 @@
     }.get(slot)
     if slot == 2494 and ver == "7.245":
         fixed = dict(type=0x988, p1=0x112, p2=0x172, sec=0x1D8, roll=0x1DE, fw=8)
+    if slot == 2494 and ver in ("7.221", "7.233", "7.243", "7.253"):
+        # the documented 7.243 layout (module docstring). calibrate() finds exactly this on every data-3 7.233 / 7.243 /
+        # 7.253 job with enough structural members (10 jobs: 7 Cives Binney jobs, Northside_job, ANNAPOLIS, 604; sections
