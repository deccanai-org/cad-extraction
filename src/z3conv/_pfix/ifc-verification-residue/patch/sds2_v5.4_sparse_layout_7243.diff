+        # with these point offsets picks 0x1D4 (3,000/3,000 beams, 152 sections; next offset scores 1/20), beams
+        # horizontal 2,997/3,000, columns vertical 890/892. MISC-only 7.243 jobs (100_Binney_Slab_Job x2,
+        # 100_Binney_Slab_Arch_Job) and that seed job have no work point key, so calibrate() raised ValueError.
+        fixed = dict(type=0x988, p1=0x112, p2=0x172, sec=0x1D4, roll=0x1DA, fw=8)
     if slot in (3204, 3404, 3600):
