+def kernel_each_guarded(f, prods, mode, stats_key, stats, on_shape):
+    """products one by one (create_shape) under an address-space cap (current size + V6_GUARD_GB, default 8): an
+    ifcopenshell polyhedral run-away (see kernel_run) becomes an ordinary failure of that one product"""
+    import ifcopenshell.geom
+    s, _, m = kernel_settings(mode)
+    t0 = time.time()
+    done = 0
+    old = None
+    if resource is not None:
+        try:
+            vm = 0
+            for line in open('/proc/self/status'):
+                if line.startswith('VmSize:'):
+                    vm = int(line.split()[1]) * 1024
+            if vm > 0:                 # Linux (/proc): cap = current address space + headroom
+                cap = vm + int(float(os.environ.get('V6_GUARD_GB', '8')) * (1 << 30))
+                old = resource.getrlimit(resource.RLIMIT_AS)
+                hard = old[1]
+                resource.setrlimit(resource.RLIMIT_AS, (cap if hard == resource.RLIM_INFINITY else min(cap, hard), hard))
+        except Exception:
+            old = None
+    failed = 0
+    try:
+        for p in prods:
+            try:
+                sh = ifcopenshell.geom.create_shape(s, p)
+                g = kernel_geometry(sh.geometry, m)
+            except Exception:          # incl. bad_alloc of a run-away under the cap
+                failed += 1
+                continue
+            done += 1
+            on_shape(p.id(), *g)
+    finally:
+        if old is not None:
+            try:
+                resource.setrlimit(resource.RLIMIT_AS, old)
+            except Exception:
+                pass
+    stats[stats_key] = {'products': len(prods), 'shapes': done, 'failed': failed, 'sec': round(time.time() - t0, 2), 'guarded': old is not None}
