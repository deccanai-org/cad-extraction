+            return sh
+        for clean, welded in [(c, w) for w in (False, True) for c in ((True, False) if ks else (False,))]:
+            _CLEAN_LOOPS = clean
+            F1 = weld(V, faces) if welded else faces
+            if welded and F1 is faces:
